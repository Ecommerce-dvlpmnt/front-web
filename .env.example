# Server-side URL of the .NET API. Keep this variable private.
API_URL=https://back-web-production-e661.up.railway.app/api

# Optional public origin for canonical and Open Graph product URLs.
# NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Use only when a browser Client Component must call the API directly.
# The .NET API must allow this origin via CORS, and this value must not contain secrets.
# NEXT_PUBLIC_API_URL=http://localhost:5000/api

# Public store origin and integrations.
# NEXT_PUBLIC_SITE_URL=https://your-domain.example
# NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX

# Public business contact and payment details. Fill with real legal data before launch.
# NEXT_PUBLIC_SHOP_PHONE=+380XXXXXXXXX
# NEXT_PUBLIC_SHOP_EMAIL=hello@your-domain.example
# NEXT_PUBLIC_SHOP_TELEGRAM=https://t.me/your_account
# NEXT_PUBLIC_SHOP_HOURS=Пн–Пт: 09:00–19:00; Сб–Нд: 10:00–18:00
# NEXT_PUBLIC_IBAN_RECIPIENT=ФОП Ім’я Прізвище
# NEXT_PUBLIC_IBAN=UA_______________________________
# NEXT_PUBLIC_RETURNS_ADDRESS=Місто, відділення Нової Пошти
